// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserPlan {
  starter
  pro
  premium
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  plan      UserPlan @default(starter)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  menus     Menu[]
}

enum DishCategory {
  veg
  nonveg
}

enum MenuTheme {
  plate
  bistro
  fresh
}

model Menu {
  id               String     @id @default(cuid())
  slug             String
  restaurantName   String?
  logoUrl          String?
  bannerUrl        String?
  zomatoUrl        String?
  zomatoRating     Float?
  swiggyUrl        String?
  swiggyRating     Float?
  whatsappNumber   String?
  tableCount       Int?
  description      String?
  imageEnhancerUrl String?
  paymentQrUrl     String?
  upiId            String?
  paypalUrl        String?
  stripeUrl        String?
  theme            MenuTheme  @default(plate)
  sourceFileName   String?
  sourceNotes      String?
  isOpen           Boolean    @default(true)
  ownerId          String
  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items            MenuItem[]
  customers        Customer[]
  ingredients      Ingredient[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([ownerId, slug])
}

/**
 * A customer who opted in to save their number when placing a WhatsApp order — powers the offer broadcast list.
 */
model Customer {
  id          String   @id @default(cuid())
  menuId      String
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  phone       String
  orderCount  Int      @default(1)
  lastOrderAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([menuId, phone])
  @@index([menuId])
}

model MenuItem {
  id          String       @id @default(cuid())
  menuId      String
  menu        Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  type        String
  category    DishCategory
  price       Int
  halfPrice   Int?
  fullPrice   Int?
  smallPrice  Int?
  mediumPrice Int?
  largePrice  Int?
  imageUrl    String?
  ingredients String[]
  section     String
  position    Int
  available   Boolean      @default(true)
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([menuId])
}

model Ingredient {
  id           String   @id @default(cuid())
  menuId       String
  name         String
  unit         String   @default("units")
  currentStock Float    @default(0)
  minStock     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}
